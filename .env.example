# Скопировать в .env (он в .gitignore) и подставить свои значения.
# ssh-хост Windows-машины с REAPER: вход по ключу, на ней OpenSSH и PowerShell
REAPER_NB_HOST=my-windows-pc.local
# Папка, где лежат проекты REAPER на этой машине
REAPER_NB_PROJECTS=C:\projects\music\reaper
# Где хранятся законченные песни (долгое хранение, например SMB-шара)
REAPER_ARCHIVE_DIR=~/mnt/server/music/reaper
